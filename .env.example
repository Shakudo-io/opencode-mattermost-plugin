# =============================================================================
# MS TEAMS BOT CONFIGURATION
# =============================================================================

# Azure AD App Registration (Required)
# Get these from the Azure setup script or Azure Portal
AZURE_APP_ID=your-app-id-here
AZURE_APP_PASSWORD=your-app-password-here
AZURE_TENANT_ID=your-tenant-id-here

# Azure AD Authorization (Required)
# Azure AD Group ID for access control - only members can use the bot
AZURE_AD_AUTHORIZED_GROUP_ID=your-security-group-id-here

# Bot Server Configuration
TEAMS_BOT_PORT=3978
TEAMS_BOT_ENDPOINT=https://opencode-teams-bot.dev.hyperplane.dev/api/messages

# OpenCode Connection
OPENCODE_SERVER_URL=http://localhost:4096

# Logging
TEAMS_LOG_FILE=/tmp/opencode-teams-bot.log

# =============================================================================
# MATTERMOST CONFIGURATION (Existing)
# =============================================================================

# Mattermost Server
MATTERMOST_TOKEN=your-bot-access-token
MATTERMOST_URL=https://your-mattermost-instance.com/api/v4
MATTERMOST_WS_URL=wss://your-mattermost-instance.com/api/v4/websocket

# Optional Mattermost Settings
MATTERMOST_TEAM=your-team-name
MATTERMOST_DEBUG=false
MATTERMOST_AUTO_CONNECT=true
MATTERMOST_OWNER_USER_ID=

# PostgreSQL State Management (Optional, for multi-instance)
OPENCODE_MM_POSTGRES_ENABLED=false
OPENCODE_MM_SUPABASE_URL=
OPENCODE_MM_SUPABASE_ANON_KEY=
OPENCODE_MM_SUPABASE_SCHEMA=opencode_mattermost

# Plugin Logging
MM_PLUGIN_LOG_FILE=/tmp/opencode-mattermost-plugin.log
